# ===========================================
# AI Engineer Assessment - Environment Config
# ===========================================
# Copy this file to .env and fill in your keys
# DO NOT commit .env to version control

# Groq - LLM + Whisper ASR (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Vapi.ai - Voice Platform Configuration
# 1. Public API Key (From Dashboard -> Account -> Public Key) used for web calling audio interface
VAPI_PUBLIC_KEY=d2685516-ae94-4892-8abd-4db236d65f64
# 2. Assistant ID (From Dashboard -> Assistants -> Copy Assistant UUID)

# 3. Private API Key (From Dashboard -> Account -> Private API Key) ONLY needed if running create_assistant python script
VAPI_API_KEY=your_private_api_key_here

# Pinecone - Vector DB (https://app.pinecone.io → API Keys)
PINECONE_API_KEY=your_pinecone_key_here

# Deepgram - Streaming ASR for Q4 (https://console.deepgram.com → API Keys)
DEEPGRAM_API_KEY=your_deepgram_key_here

# ngrok - Webhook tunnel (https://dashboard.ngrok.com → Your Authtoken)
NGROK_AUTH_TOKEN=your_ngrok_token_here

# Server Config
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
